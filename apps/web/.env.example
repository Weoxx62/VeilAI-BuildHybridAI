# Firebase Web App Configuration (Safe public client identifiers from Firebase Console -> Project Settings)
# Copy this file to .env.local and fill in your Firebase project values.
# NEVER commit .env.local, production secrets, or App Check debug tokens.

VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=veilai-hybrid.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=veilai-hybrid
VITE_FIREBASE_STORAGE_BUCKET=veilai-hybrid.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Firebase App Check (Recommended: reCAPTCHA v3 site key for production Hosting)
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Local / Judge Testing ONLY: set to "true" to print an auto-generated App Check debug token
# in the browser console (register that UUID in Firebase Console -> App Check -> Manage debug tokens).
VITE_APPCHECK_DEBUG_TOKEN=true

# Optional: Chrome Prompt API Origin Trial token for non-localhost production Hosting domains
VITE_CHROME_ORIGIN_TRIAL_TOKEN=
